	// @Scheduled(initialDelayString = "${scan.initial.delay.ms}", fixedDelayString = "${scan.fixed.delay.ms}")
	public void scanAndProcess() {
		log.info("Inside CkycLotController");
		recoverStaleClaims();

		List<Path> candidates;
		try {
			candidates = listCandidateZips();
		} catch (IOException e) {
			log.error("[{}] Failed to list input directory: {}", props.getServerId(), e.getMessage());
			return;
		}

		for (Path candidate : candidates) {
			Optional<Path> claimed = tryClaim(candidate);
			if (claimed.isEmpty()) {
				continue; // another server (or thread) already took it
			}
			try {
				processClaimedZip(claimed.get());
			} catch (Exception e) {
				// Never let one bad file stop the scan of the rest.
				log.error("[{}] Unexpected failure processing {}: {}", props.getServerId(),
						claimed.get().getFileName(), e.getMessage(), e);
				moveQuietly(claimed.get(), props.errorPath());
			}
		}
	}

	//  @Scheduled(fixedDelayString = "${stale.recovery.fixed.delay.ms}")
