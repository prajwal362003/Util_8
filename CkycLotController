	// ==================================================================
	// File claim (multi-server safe queue)
	// ==================================================================

	private List<Path> listCandidateZips() throws IOException {
		Path input = props.inputPath();
		if (!Files.isDirectory(input)) {
			log.warn("Input directory does not exist yet: {}", input);
			return List.of();
		}
		List<Path> result = new ArrayList<>();
		try (Stream<Path> stream = Files.list(input)) {
			stream.filter(Files::isRegularFile)
			.filter(p -> props.zipFilePattern().matcher(p.getFileName().toString()).matches())
			.sorted()
			.forEach(result::add);
		}
		return result;
	}

	private Optional<Path> tryClaim(Path candidate) {
		Path myProcessingDir = props.processingPathForThisServer();
		try {
			Files.createDirectories(myProcessingDir);
			Path target = myProcessingDir.resolve(candidate.getFileName());
			Files.move(candidate, target, StandardCopyOption.ATOMIC_MOVE);
			log.info("[{}] Claimed file: {}", props.getServerId(), candidate.getFileName());
			return Optional.of(target);
		} catch (NoSuchFileException | FileAlreadyExistsException e) {
			return Optional.empty();
		} catch (IOException e) {
			log.error("[{}] Error claiming {}: {}", props.getServerId(), candidate.getFileName(), e.getMessage());
			return Optional.empty();
		}
	}

	/** Only ever touches THIS server's own processing subdirectory - cannot race another live server. */
	private void recoverStaleClaims() {
		log.info("Inside recoverStaleClaims");
		Path myProcessingDir = props.processingPathForThisServer();

		log.info("ProcessingDir : {}", myProcessingDir);

		// boolean isDir = Files.isDirectory(myProcessingDir);
		if (!Files.isDirectory(myProcessingDir)) return;
		log.info("props.getStaleClaimMinutes() " + props.getStaleClaimMinutes());
		Instant staleBefore = Instant.now().minusSeconds(props.getStaleClaimMinutes() * 60);
		log.info("staleBefore : " + staleBefore);

		try (Stream<Path> stream = Files.list(myProcessingDir)) {

			for (Path p : stream.filter(Files::isRegularFile).toList()) {
				FileTime mtime = Files.getLastModifiedTime(p);
				if (mtime.toInstant().isBefore(staleBefore)) {
					Path back = props.inputPath().resolve(p.getFileName());
					try {
						Files.move(p, back, StandardCopyOption.ATOMIC_MOVE);
						log.info("[{}] Recovered stale claim, requeued: {}", props.getServerId(), p.getFileName());
					} catch (IOException ex) {
						log.error("[{}] Failed to requeue stale file {}: {}", props.getServerId(), p, ex.getMessage());
					}
				}
			}
		} catch (IOException e) {
			log.error("[{}] Error scanning for stale claims: {}", props.getServerId(), e.getMessage());
		}
	}

	// ==================================================================
	// Per-file pipeline
	// ==================================================================
	//            //lotNo = summaryFileName.split("_")[1];

	private void processClaimedZip(Path claimedZip) throws IOException {
		LocalDateTime start = LocalDateTime.now();
		String zipFileName = claimedZip.getFileName().toString();
		log.info("[{}] Processing {}", props.getServerId(), zipFileName);

		// 1) Backup BEFORE any extraction/parsing is attempted.
		backup(claimedZip);

		// 2) Decrypt + extract the two CSVs into a per-file work directory.
		Path workDir = props.processingPathForThisServer().resolve(stripExt(zipFileName) + "_" + TS_FMT.format(start));
		Path detailsXls;
		Path summaryXls;
		try {
			var pair = extractZip(claimedZip, workDir);
			detailsXls = pair.details();
			summaryXls = pair.summary();
		} catch (LotProcessingException e) {
			recordFailureAndMove(claimedZip, zipFileName, null, start, "EXTRACT_FAILED: " + e.getMessage());
			cleanup(workDir);
			return;
		}
		// 3) Parse.
		String summaryFileName = summaryXls.getFileName().toString();
		log.info("summaryFileName : "+summaryFileName);

		String lotNo;
		List<CustomerRecord> records;
		List<String> warnings;
		try {
			lotNo = extractLotNoFromSummary(summaryXls);
			log.info("lotNo : "+lotNo);

			// List<String> lines = Files.readAllLines(detailsXls, StandardCharsets.UTF_8);

			records = new ArrayList<>();
			warnings = new ArrayList<>();
			log.info("_____ : ");
			
			parseDetails(summaryXls, lotNo, records, warnings);
			log.info("Total records parsed : "+records.size());
			log.info("Total warnings: {}" + warnings.size());

		} catch (Exception e) {
			recordFailureAndMove(claimedZip, zipFileName, summaryFileName, start, "PARSE_FAILED: " + e.getMessage());
			cleanup(workDir);
			return;
		}

		boolean[] committed = {false};
		String[] errorHolder = {null};

		//final String finalLotNo = lotNo;
		log.info("Total warnings: {}" + warnings.size());
		// 4) Idempotency check - has this summary file already been loaded successfully?
		
		boolean existsByFileName= dao.existsBySummaryFileName(summaryFileName);
		log.info("existsByFileName " +existsByFileName);
		Set<String> xlsxCifs = storeIntoSet(records);
		log.info("xlsxCifs " +xlsxCifs.size());

		Set<String> existingCustomers = dao.getExistingCifNumbers(xlsxCifs);
				//dao.getExistingCustomerNumbers(summaryFileName);
		log.info("existingCustomers " +existingCustomers.size());
		
		if (existsByFileName||existingCustomers.size()>0) {
			log.warn("[{}] Duplicate detected,{}", props.getServerId(), summaryFileName);
			
			List<CustomerRecord> updateList = new ArrayList<>();
			List<CustomerRecord> insertList = new ArrayList<>();
		
			for(CustomerRecord customerRecord : records) {
				if(existingCustomers.contains(customerRecord.cifNo()))
					updateList.add(customerRecord);
				else
					insertList.add(customerRecord);
			}
			log.info("updateList " +updateList.size());
			if(updateList.size()>0) {
				transactionTemplate.execute(status -> {
					try {
						log.info("executing batches for updateList ");
						dao.batchUpdateCustomerData(updateList, zipFileName, summaryFileName, updateList.size());
						dao.insertHistory(updateList,updateList.size());
						committed[0] = true;
						return null;
					} catch (Exception e) {
						status.setRollbackOnly();
						errorHolder[0] = e.getMessage();
						return null;
					}
				});
			}
			log.info("insertList " +insertList.size());
			if(insertList.size()>0) {
				// 5) Batch insert + history insert in one transaction.
				transactionTemplate.execute(status -> {
					try {
						log.info("executing batches for insertList ");
						dao.batchInsertCustomerData(insertList, zipFileName, summaryFileName, insertList.size());
						dao.insertHistory(insertList,insertList.size());
						committed[0] = true;
						return null;
					} catch (Exception e) {
						status.setRollbackOnly();
						errorHolder[0] = e.getMessage();
						return null;
					}
				});
			}

		}else {

			log.info("Total records in else : {}" + records.size());
			final List<CustomerRecord> finalRecords = records;
			// 5) Batch insert + history insert in one transaction.
			transactionTemplate.execute(status -> {
				try {
					log.info("transactionTemplate.execute");
					int[][] a =dao.batchInsertCustomerData(finalRecords, zipFileName, summaryFileName, props.getDbBatchSize());
					log.info("__________________!!  !! ! ______________________" );
					log.info("Total records in else : {}" + a.length);

					dao.insertHistory(finalRecords,finalRecords.size());

					committed[0] = true;
					return null;
				} catch (Exception e) {
					log.error("transactionTemplate.execute {}",e);
					status.setRollbackOnly();
					errorHolder[0] = e.getMessage();
					return null;
				}
			});
		}

		log.info("__________________|______________________" );
		LocalDateTime end = LocalDateTime.now();
		if (committed[0]) {
			ProcessingHistory successHistory = new ProcessingHistory(zipFileName, summaryFileName, lotNo,
					records.size(), records.size(), 0, "SUCCESS", props.getServerId(), start, end,
					warnings.isEmpty() ? null : String.join("; ", warnings));
			writeResponse(stripExt(zipFileName), successHistory);
			moveQuietly(claimedZip, props.processedPath());
			log.info("[{}] Completed {} - {} records", props.getServerId(), zipFileName, records.size());
		} else if ("DUPLICATE_AT_DB_LEVEL".equals(errorHolder[0])) {
			ProcessingHistory dupHistory = new ProcessingHistory(zipFileName, summaryFileName, lotNo,
					records.size(), 0, records.size(), "DUPLICATE", props.getServerId(), start, end,
					"Lost DB-level race on summary_file_name unique constraint");
			writeResponse(stripExt(zipFileName), dupHistory);
			moveQuietly(claimedZip, props.processedPath());
		} else {
			recordFailureAndMove(claimedZip, zipFileName, summaryFileName, start, "DB_INSERT_FAILED: " + errorHolder[0]);
		}
		cleanup(workDir);
	}

	private static Set<String> storeIntoSet(List<CustomerRecord> records) {
		Set<String> cifSet = new HashSet<>();
		for(CustomerRecord customer: records) {
			cifSet.add(customer.cifNo());
		}
		return cifSet;
	}

	private void recordFailureAndMove(Path claimedZip, String zipFileName, String summaryFileName,
			LocalDateTime start, String reason) {
		LocalDateTime end = LocalDateTime.now();
		log.error("[{}] {} - {}", props.getServerId(), zipFileName, reason);
		try {
			ProcessingHistory failHistory = new ProcessingHistory(zipFileName,
					summaryFileName == null ? zipFileName : summaryFileName, null, 0, 0, 0, "FAILED", props.getServerId(), start, end, reason);
			//dao.insertHistory(insertList,insertList.size());
			writeResponse(stripExt(zipFileName), failHistory);
		} catch (Exception e) {
			log.error("[{}] Also failed to record failure history for {}: {}", props.getServerId(), zipFileName, e.getMessage());
		}
		moveQuietly(claimedZip, props.errorPath());
	}

