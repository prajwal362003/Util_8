	private void writeResponse(String zipBaseName, ProcessingHistory history) {
		try {
			Files.createDirectories(props.outputPath());
			String fileName = zipBaseName + "_RESPONSE_" + TS_FMT.format(history.endTime()) + ".txt";
			Path target = props.outputPath().resolve(fileName);

			String content = """
					CKYC LOT PROCESSING RESPONSE
					=============================
					Zip File          : %s
					Summary File      : %s
					Lot No            : %s
					Processed By      : %s
					Start Time        : %s
					End Time          : %s
					Status            : %s
					Total Records     : %d
					Success Records   : %d
					Failed Records    : %d
					Error Reason      : %s
					""".formatted(
							history.zipFileName(), history.summaryFileName(), history.lotNo(),
							history.processedByServer(), history.startTime(), history.endTime(), history.status(),
							history.totalRecords(), history.successRecords(), history.failedRecords(),
							history.errorReason() == null ? "-" : history.errorReason()
							);

			Files.writeString(target, content, StandardCharsets.UTF_8,
					StandardOpenOption.CREATE, StandardOpenOption.TRUNCATE_EXISTING);
		} catch (IOException e) {
			log.error("[{}] Failed to write response file for {}: {}", props.getServerId(), zipBaseName, e.getMessage());
		}
	}

