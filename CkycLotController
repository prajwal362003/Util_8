	private void backup(Path claimedZip) {
		try {
			log.info("claimedZip  : "+claimedZip);

			copyTo(claimedZip,props.backupPath());
			
		} catch (IOException e) {
			throw new LotProcessingException("Failed to back up " + claimedZip, e);
		}
	}
	

	
	private void copyTo(Path source, Path target) throws IOException {
	
		Files.createDirectories(target);
		Path destination=target.resolve(source.getFileName());
		
		log.info("Source : " + source);
		log.info("Destination : " + destination);
		
		Files.copy(source, destination, StandardCopyOption.REPLACE_EXISTING,StandardCopyOption.COPY_ATTRIBUTES);
		
		log.info("Successfully copied to : " + destination);
	}
	
	private static void deleteDirectoryRecursively(Path target) throws IOException {
		if(!Files.exists(target)) return;
		try(Stream<Path> paths = Files.walk(target)){
			paths.sorted(Comparator.reverseOrder())
				.forEach(path->{
					try {
						Files.delete(path);
					}catch(IOException e) {
						throw new UncheckedIOException(e);
					}
				});
		}catch(UncheckedIOException e) {
			log.error("exception: {}", e.getCause());
		}
	}

	// ==================================================================
	// Zip extraction (password protected, zip4j)
	// ==================================================================

	private record CsvPair(Path details, Path summary) {}

	private CsvPair extractZip(Path zipFile, Path destDir) {
		try {
			Files.createDirectories(destDir);
			ZipFile zf = new ZipFile(zipFile.toFile());

			String[] fileNameArray=zf.getFile().getName().split("_");
			String dateString= fileNameArray[2]; 
			
			
			DateTimeFormatter formatter = DateTimeFormatter.ofPattern("ddMMyyyy");

			LocalDate localDate = LocalDate.parse(dateString, formatter);

			ZoneId zone = ZoneId.of("Asia/Kolkata"); 
			ZonedDateTime zdt = localDate.atStartOfDay(zone);

			int month = zdt.getMonthValue();

			WeekFields weekFields = WeekFields.of(Locale.getDefault()); 
			int weekOfMonth = zdt.get(weekFields.weekOfMonth());
			
			String password =  props.getZipPassword()+month+weekOfMonth;//"password@""password@85";+"85";// 
			//log.info("Zip Protected Password:" + password);
			
			
			if (zf.isEncrypted()) {
				log.info("Zip Protected Password:" + password);
				zf.setPassword(password.toCharArray());
			}

			List<FileHeader> headers = zf.getFileHeaders();
			if (headers.isEmpty()) {
				throw new LotProcessingException("Zip is empty: " + zipFile);
			}
			log.info("Zip Protected Password:" + password);
			try{
				zf.extractAll(destDir.toString());
			}catch(Exception e) {
				log.error("Error unzipping password :" + e.getMessage());
			}

			Path details = null, summary = null;
			List<String> found = new ArrayList<>();
			for (FileHeader fh : headers) {
				if (fh.isDirectory()) continue;
				String name = fh.getFileName();
				log.info("name:" +name);
				found.add(name);
				Path extracted = destDir.resolve(name);
				log.info("extracted:" + extracted.toString());
				if (name.endsWith(props.getDetailsFileSuffix())) details = extracted;
				else if (name.endsWith(props.getSummaryFileSuffix())) summary = extracted;
			}
			log.info("details: " + details+"  summary : "+summary);
			if (details == null || summary == null) {
				throw new LotProcessingException("Expected one *" + props.getDetailsFileSuffix() + " and one *"
						+ props.getSummaryFileSuffix() + " inside " + zipFile.getFileName() + " but found: " + found);
			}
			log.info("details: " + details+"  summary : "+summary);
			return new CsvPair(details, summary);

			//[SVR01] PAT_LOT209_28082025_1_Response_1758113224.zip - PARSE_FAILED: Input length = 1
		} catch (net.lingala.zip4j.exception.ZipException e) {
			throw new LotProcessingException("Failed to extract (bad password or corrupt zip): " + zipFile, e);
		} catch (IOException e) {
			throw new LotProcessingException("IO error extracting: " + zipFile, e);
		}
	}


	private String extractLotNoFromSummary(Path summaryXlsx) throws IOException {
		//  List<String> lines = Files.readAllLines(summaryCsv, StandardCharsets.UTF_8);

		log.info("Excel Path : {}", summaryXlsx);
		log.info("File name : {}", summaryXlsx.getFileName());
		log.info("Exists : {}", Files.exists(summaryXlsx));
		log.info("Is regular file : {}", Files.isRegularFile(summaryXlsx));
		log.info("File Size : {}", Files.size(summaryXlsx));

		DataFormatter formatter = new DataFormatter();

		//try(Workbook workbook = WorkbookFactory.create(summaryXlsx.toFile())){
		
		
		ZipSecureFile.setMinInflateRatio(0.001);  // or 0.001, or 0 to disable the check entirely


		try(InputStream is = Files.newInputStream(summaryXlsx);
				XSSFWorkbook workbook=new XSSFWorkbook(is)){
			log.info("workbook : ");
			Sheet sheet = workbook.getSheetAt(0);
			log.info("2 : ");
			if (sheet.getPhysicalNumberOfRows() < 2)  return null;
			Row headerRow = sheet.getRow(0);
			if (headerRow == null)  return null;
			log.info("headerRow : "/* +headerRow */);
			Map<String,Integer> headerMap = new HashMap<>();
			for (Cell cell : headerRow) {
				log.info("3 : "+ formatter.formatCellValue(cell).trim());
				headerMap.put(formatter.formatCellValue(cell).trim(), cell.getColumnIndex());
			}
			Integer lotNoColumn = headerMap.get("Lot No");
			log.info("4 : ");
			if (lotNoColumn == null) return null;
			Row firstRow = sheet.getRow(1);
			log.info("firstRow : "/* +firstRow */);
			if (firstRow == null)return null;
			Cell lotCell = firstRow.getCell(lotNoColumn);
			log.info("lotCell : "+lotCell);
			return formatter.formatCellValue(lotCell).trim();
		}
	}



	private void parseDetails(Path detailsXls, String lotNo, List<CustomerRecord> records, List<String> warnings) throws IOException {

		DataFormatter formatter = new DataFormatter();
		try (InputStream is = Files.newInputStream(detailsXls);
				XSSFWorkbook workbook = new XSSFWorkbook(is)){

			Sheet sheet = workbook.getSheetAt(0);
			
			String lcpc=detailsXls.getFileName().toString().split("_")[0];

			log.info("Details sheet name : {}",sheet.getSheetName());
			log.info("Last Row Number : {}",sheet.getLastRowNum());

			Row headerRow = sheet.getRow(0);
			if (headerRow == null) {
				throw new IOException("Header Row not found in details XLSX");
			}

			Map<String,Integer>headerIdx = new HashMap<>();

			for (Cell cell : headerRow) {
				String headerName = formatter.formatCellValue(cell).trim();

				if (!headerName.isEmpty()) {
					headerIdx.put(headerName, cell.getColumnIndex());

					log.info("Header [{}] -> column [{}]," + headerName, cell.getColumnIndex());
				}
			}

			for (int rowNo = 1;rowNo <= sheet.getLastRowNum();rowNo++) {
				Row row = sheet.getRow(rowNo);
				if (row == null || isRowEmpty(row,formatter)) continue;

				try {
					records.add(toCustomerRecord(row,headerIdx,lotNo,formatter,lcpc,detailsXls.getFileName().toString()));	//CustomerRecord record = toCustomerRecord(row,headerIdx,lotNo,formatter);
				}catch(Exception e) {
					String warning = "Row" + (rowNo+1) + " skipped: " + e.getLocalizedMessage();
					warnings.add(warning);
					log.error(warning,e);
				}
			}
		}
	}

	private boolean isRowEmpty(Row row,DataFormatter formatter) {
		if (row == null) return true;
		for (Cell cell: row) {
			String value = formatter.formatCellValue(cell).trim();
			if (!value.isEmpty()) return false;
		}
		return true;
	}

	private CustomerRecord toCustomerRecord(Row row, Map<String, Integer> h, String lotNo,DataFormatter formatter, String lcpc, String fileName) {

		String subLotNo = XlsUtils.getExcelValue(row, h, "Sub Lot No",formatter);
		String seqStr = XlsUtils.getExcelValue(row, h, "#",formatter);
		Integer seqNo = null;
		if(seqStr!=null&&!seqStr.isBlank()) {
			String numSeq=seqStr.replaceAll("[^0-9]", "");
			if(!numSeq.isBlank()) seqNo=Integer.valueOf(numSeq);
		}
		      
		return new CustomerRecord(
				XlsUtils.getExcelValue(row, h, "Lot No",formatter),
				XlsUtils.getExcelValue(row, h, "Sub Lot No",formatter),
				XlsUtils.getExcelValue(row, h, "CIF",formatter),
				XlsUtils.getExcelValue(row, h, "Account number",formatter),
				XlsUtils.getExcelValue(row, h, "Categorization",formatter),
				fileName,
				lcpc,
				parseDob(XlsUtils.getExcelValue(row, h, "ExcelPullTime",formatter)),
				parseDob(XlsUtils.getExcelValue(row, h, "ExcelEntryTime",formatter)),
				XlsUtils.getExcelValue(row, h, "Error Reason",formatter)
				);
	}


	private LocalDate parseDob(String raw) {
		if (raw == null) return null;
		try {
			return LocalDate.parse(raw.trim(), DOB_FMT);
		} catch (Exception e) {
			return null;
		}
	}

